{
  "name": "zhengya-sharedtoolbox-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.{mjs,json}\" index.html vite.config.ts tsconfig.json package.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.{mjs,json}\" index.html vite.config.ts tsconfig.json package.json .prettierrc.json",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "jsqr": "1.4.0"
  }
}
